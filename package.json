{
  "name": "@zz-jason/pi-extensions",
  "version": "0.2.0",
  "description": "A collection of practical extensions for pi",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zz-jason/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/zz-jason/pi-extensions/issues"
  },
  "homepage": "https://github.com/zz-jason/pi-extensions#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "files": [
    "extensions",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "commitlint": "commitlint --config config/commitlint.config.mjs",
    "format": "prettier --config config/prettier.config.mjs --write .",
    "format:check": "prettier --config config/prettier.config.mjs --check .",
    "lint": "eslint --config config/eslint.config.mjs .",
    "typecheck": "tsc --project config/tsconfig.json --noEmit",
    "test": "vitest --config config/vitest.config.ts run",
    "test:coverage": "vitest --config config/vitest.config.ts run --coverage",
    "package:check": "npm pack --dry-run",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run package:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "pi": {
    "extensions": [
      "./extensions/context-status/index.ts",
      "./extensions/auto-compact-70.ts",
      "./extensions/response-style.ts"
    ]
  }
}
